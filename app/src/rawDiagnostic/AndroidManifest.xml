<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission tools:node="removeAll" />
    <uses-feature tools:node="removeAll" />
    <permission tools:node="removeAll" />
    <application android:label="Cinematic RAW Diagnostic" tools:replace="android:label">
        <profileable android:shell="true" />
        <activity android:name=".MainActivity" tools:node="remove" />
        <activity android:name=".photoroll.PhotoRollActivity" tools:node="remove" />
        <service tools:node="removeAll" />
        <provider tools:node="removeAll" />
        <receiver tools:node="removeAll" />
        <activity android:name=".rawdiagnostic.RawDiagnosticActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

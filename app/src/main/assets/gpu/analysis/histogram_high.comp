#version 320 es
precision highp float;
precision highp int;
precision highp sampler2D;
precision highp isampler2D;

layout(local_size_x = 8, local_size_y = 8) in;
uniform sampler2D s_input;
uniform ivec2 u_size;
// 呼び出し元が全ビンを 0 に初期化する。入力は有限な R32F の平滑 log 輝度。
layout(std430, binding = 0) buffer HighHistogram {
    uint counts[65536];
};

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, u_size))) return;
    int bits = floatBitsToInt(texelFetch(s_input, pixel, 0).r);
    // OriginalQuantiles.key。符号付き値、負のゼロも順序を保持する。
    uint key = uint(bits) ^ (bits < 0 ? 0xffffffffu : 0x80000000u);
    atomicAdd(counts[key >> 16u], 1u);
}

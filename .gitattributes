* text=auto
*.sh text eol=lf
gradlew text eol=lf
*.yml text eol=lf
*.jar binary

# Preserve the exact UTF-8 input documents across Windows checkouts.
docs/DEVELOP_UI_REFACTOR_INSTRUCTIONS.md text eol=lf
docs/cinematic-camera-roadmap-v3.md text eol=lf

# Preserve the upstream license bytes and deterministic source notice in APK assets.
app/src/main/assets/third_party/dng_temperature/LICENSE -text
app/src/main/assets/third_party/dng_temperature/SOURCE.txt text eol=lf

# Synthetic regression data is generated; keep review focused on code and generators.
app/src/test/resources/stage_clear_*.csv linguist-generated=true
app/src/test/resources/stage_clear_*.csv.gz binary linguist-generated=true
app/src/test/resources/r7_preview_inputs_v1.csv.gz binary linguist-generated=true
app/src/test/resources/detected_face_masks_v1.csv.gz binary linguist-generated=true
